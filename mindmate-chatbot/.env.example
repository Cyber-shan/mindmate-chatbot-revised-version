# Hosted Supabase: use the URL and keys from the SAME project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only: accepts sb_secret_... or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_KEY

# Keep the existing owner UUID when importing local accounts.
MINDMATE_OWNER_USER_ID=
SUPPORT_REVIEW_QUEUE_ENABLED=false

# Chat generation and classification still run on this laptop.
OLLAMA_URL=http://127.0.0.1:11434
DISTRESS_CLASSIFIER_URL=http://127.0.0.1:8001
